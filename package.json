{
  "name": "hmip-eufy-mower-plugin",
  "version": "1.1.1",
  "description": "Homematic IP HCU plugin that bridges Eufy E15/E18 robotic lawn mowers (Tuya v3.5 local protocol) into the HMIP app, no cloud required.",
  "author": "Fabio Renner",
  "license": "Apache-2.0",
  "homepage": "https://github.com/fabiorenner-hub/hmip-hcu-eufymower#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabiorenner-hub/hmip-hcu-eufymower.git"
  },
  "bugs": {
    "url": "https://github.com/fabiorenner-hub/hmip-hcu-eufymower/issues"
  },
  "keywords": [
    "homematic",
    "hmip",
    "hcu",
    "eufy",
    "tuya",
    "mower",
    "lawn-mower",
    "smart-home"
  ],
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --enable-source-maps src/index.js",
    "smoke": "node .smoketest.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "tuyapi": "^7.7.1",
    "ws": "^8.16.0"
  }
}
